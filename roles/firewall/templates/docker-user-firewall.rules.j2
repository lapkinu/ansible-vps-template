*filter
:DOCKER-USER - [0:0]

-A DOCKER-USER -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
{% for interface in docker_bridge_interfaces %}
-A DOCKER-USER -i {{ interface }} -j RETURN
{% endfor %}
{% for port in docker_public_tcp_ports %}
-A DOCKER-USER -p tcp -m conntrack --ctstate NEW --ctorigdstport {{ port }} -j ACCEPT
{% endfor %}
{% for port in docker_public_udp_ports %}
-A DOCKER-USER -p udp -m conntrack --ctstate NEW --ctorigdstport {{ port }} -j ACCEPT
{% endfor %}
-A DOCKER-USER -j DROP

COMMIT
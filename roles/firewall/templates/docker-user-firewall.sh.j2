#!/bin/bash

set -e

iptables -C DOCKER-USER \
    -m conntrack \
    --ctstate ESTABLISHED,RELATED \
    -j ACCEPT 2>/dev/null || \
iptables -A DOCKER-USER \
    -m conntrack \
    --ctstate ESTABLISHED,RELATED \
    -j ACCEPT

{% for interface in docker_bridge_interfaces %}
iptables -C DOCKER-USER \
    -i {{ interface }} \
    -j RETURN 2>/dev/null || \
iptables -I DOCKER-USER {{ loop.index + 1 }} \
    -i {{ interface }} \
    -j RETURN

{% endfor %}
{% for port in docker_public_tcp_ports %}
iptables -C DOCKER-USER \
    -p tcp \
    -m conntrack \
    --ctstate NEW \
    --ctorigdstport {{ port }} \
    -j ACCEPT 2>/dev/null || \
iptables -A DOCKER-USER \
    -p tcp \
    -m conntrack \
    --ctstate NEW \
    --ctorigdstport {{ port }} \
    -j ACCEPT

{% endfor %}
iptables -C DOCKER-USER \
    -j DROP 2>/dev/null || \
iptables -A DOCKER-USER \
    -j DROP